{
  "name": "portfolio-server",
  "version": "1.0.0",
  "description": "REST API powering the personal portfolio website",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "admin:set": "node --env-file-if-exists=.env scripts/set-admin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongodb": "^7.9.1",
    "multer": "^2.5.0"
  }
}
