# Copy to .env and adjust
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins (only needed if client is hosted elsewhere)
CORS_ORIGINS=http://localhost:4000

# Signs login sessions. Use 32+ random characters; required in production.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
# How long a login lasts (hours)
SESSION_TTL_HOURS=2

# Optional: creates the admin account on first start if none exists.
# Remove these after the first start. Or run: npm run admin:set -- <username> <password>
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-strong-password



# Optional: FREE AI review in the CV Maker's ATS score.
# Add as many free keys as you like — every configured model reviews the CV at the same time
# and their results are merged (average score, combined tips). Leave all empty to turn AI off.
#   Gemini      https://aistudio.google.com/apikey
#   Groq        https://console.groq.com/keys
#   OpenRouter  https://openrouter.ai/keys
#   Ollama      no key, runs on your PC: https://ollama.com  then: ollama pull llama3.1
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_ENABLED=true
# Optional model overrides: GEMINI_MODEL, GROQ_MODEL, OPENROUTER_MODEL, OLLAMA_MODEL
# AI_REVIEWS_PER_HOUR=10        # per visitor IP — protects your free quotas

# Storage: leave empty to use files in server/data + server/uploads (local).
# On free hosts whose disk is wiped on restart (Render), use a free MongoDB Atlas database:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/farhankit?retryWrites=true&w=majority
